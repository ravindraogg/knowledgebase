NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/recalix

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Configuration (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth Configuration
JWT_SECRET=super_secret_jwt_key_recalix_change_me_in_production
JWT_EXPIRY=7d

# Encryption Key (32 bytes hex-encoded, for credential encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# Hugging Face reasoning (server-side token; never expose this in the frontend)
HUGGINGFACE_API_TOKEN=hf_your_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
